# Shortener: environment variables
# Copy to .env for local development. Never commit real values.
# Full reference: docs/app-runtime.md (section 4).

# --- Required: the app refuses to start without these -----------------------

# PostgreSQL connection (SECRET; inject from a secret store outside local dev).
# Accepted schemes: postgresql://, postgres://, postgresql+asyncpg://
DATABASE_URL=postgresql://shortener:CHANGE_ME@localhost:5432/shortener

# One of: local, test, staging, qa, prod
APP_ENV=local

# Build identity, normally baked into the image at build time (not set per deploy).
# GIT_SHA: 7-40 hex characters.
APP_VERSION=0.0.0-dev
GIT_SHA=0000000

# Public origin of this environment; used to build short_url in responses.
PUBLIC_BASE_URL=http://localhost:8000

# --- Optional (defaults shown) ------------------------------------------------

# HTTP listen port (the app always binds 0.0.0.0).
# PORT=8000

# DEBUG, INFO, WARNING or ERROR
# LOG_LEVEL=INFO

# Connections per replica = DB_POOL_SIZE + DB_MAX_OVERFLOW
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5

# How long /readyz waits for the database before answering 503.
# READINESS_TIMEOUT_SECONDS=2

# Max time to drain in-flight requests after SIGTERM.
# Keep the orchestrator's stop timeout above this value.
# SHUTDOWN_TIMEOUT_SECONDS=20

# --- Chaos testing (canary rollback demos) -----------------------------------

# Fraction (0.0-1.0) of /api/* requests that return HTTP 500 on purpose.
# Redirects, health, version and metrics endpoints are never affected.
# CHAOS_ERROR_RATE=0

# With APP_ENV=prod, a CHAOS_ERROR_RATE above 0 is refused at startup unless
# this is true. Leave false.
# CHAOS_ALLOW_IN_PROD=false

# --- Tests only (never read by the application) ------------------------------

# Disposable database for integration tests (app/tests/integration). They
# TRUNCATE and DROP tables. Tests never use DATABASE_URL, and refuse to run if
# this names the same database as DATABASE_URL. Unset = integration tests skip.
# TEST_DATABASE_URL=postgresql://shortener:CHANGE_ME@localhost:5432/shortener_test
